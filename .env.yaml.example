# Application Configuration
# Copy to .env.yaml and fill in your values (that file is gitignored)

redis:
  url: "redis://localhost:6379/0"
  paper_queue: "q:papers:v1"
  paper_processing: "q:papers:processing:v1"
  paper_dedup_set: "s:papers:enqueued:v1"
  completed_papers_queue: "q:papers:completed:v1"
  generated_set: "s:papers:generated:v1"
  ann_queue: "q:annotations:completed:v1"
  ann_flush_threshold: 1000
  ann_persist_path: "data_labeling/annotations.jsonl"
  ann_flush_on_exit: true
  ann_install_signal_handlers: true
  human_paper_queue: "q:papers:human:v1"
  human_processing_queue: "q:papers:human:processing:v1"
  human_dedup_set: "s:papers:human:enqueued:v1"

minio:
  url: "localhost:9000"
  access_key: ""
  secret_key: ""
  bucket_name: "v1-criteria-classified-articles"
  secure: false
  human_annotations_bucket: "human-annotations"
  annotations_bucket: "completed-annotations"

pinecone:
  api_key: ""
  index_name: "adbm"
  namespace: "article_upload_test_2"
  human_namespace: "V3_raw_pubmed_articles"

label_studio:
  url: ""
  api_key: ""
  webhook_host: "http://localhost:8000"

embeddings:
  api_key: ""  # OpenAI API key for embeddings
  model: "text-embedding-ada-002"

seed:
  queue_file: "utilities/test_papers.txt"
  human_papers_file: "utilities/human_papers.txt"

llm_providers:
  ollama:
    api_key: dummy
    models:
      - model: llama3.1
        base_url: http://localhost:11434
        temperature: 0.7
        skip: false

  openai:
    api_key: ""
    models:
      - model: gpt-4o
        temperature: 0.1
        skip: true

  anthropic:
    api_key: ""
    models:
      - model: claude-3-sonnet-20240229
        temperature: 0.1
        skip: true

  huggingface:
    api_key: ""
    models:
      - model: microsoft/DialoGPT-medium
        temperature: 0.1
        skip: true

  vllm:
    api_key: ""  # not used for vLLM
    models:
      - model: "openai/gpt-oss-120b"
        base_url: "http://localhost:8080/v1"
        temperature: 0.1
        skip: true
