# =============================================================================
# LiteratureAnnotator — application configuration (example)
# =============================================================================
# Copy this file to `.env.yaml` in the project root and fill in secrets.
# `.env.yaml` is gitignored. `load_app_config()` reads `.env.yaml` only.
#
# Optional merge: if `override.env.yaml` exists beside `.env.yaml`, its keys are
# deep-merged on top (Docker often mounts `.env.docker-override.yaml` there).
# =============================================================================

# -----------------------------------------------------------------------------
# redis — job queues, deduplication, and annotation buffering
# -----------------------------------------------------------------------------
# Used by: labeling scripts (data_generation/), Label Studio FastAPI (`label_api/app.py`),
# utilities/queue_helpers.py. Use distinct key names if you run multiple envs
# on one Redis to avoid cross-talk.
#
redis:
  # Connection URL, e.g. redis://localhost:6379/0 (db 0). Same Redis can host
  # all lists/sets below if the prefix names differ.
  url: "redis://localhost:6379/0"

  # Main paper pipeline: IDs waiting for LLM labeling (seed_queue enqueues here).
  paper_queue: "q:papers:v1"

  # In-flight papers moved here by claim_next_paper (BRPOPLPUSH); cleared by ack_paper
  # or returned via requeue_inflight on failure.
  paper_processing: "q:papers:processing:v1"

  # Redis SET: paper IDs accepted for enqueue (dedup). Prevents duplicate queue entries;
  # ack_paper removes the ID from this set when work is finished.
  paper_dedup_set: "s:papers:enqueued:v1"

  # Redis LIST: legacy bookkeeping for “completed” paper IDs (export scripts), not the
  # same as LS import—see push_completed_paper / export_completed_papers_to_file.
  completed_papers_queue: "q:papers:completed:v1"

  # Redis SET: IDs recorded after a labeling batch (generated set); optional/alternate workflow.
  generated_set: "s:papers:generated:v1"

  # Redis LIST: completed Label Studio annotations buffered here before JSONL flush.
  ann_queue: "q:annotations:completed:v1"

  # When ann_queue length exceeds this, flush_annotations_to_persistent drains to disk.
  ann_flush_threshold: 1000

  # Append-only JSONL path for flushed annotations (relative to cwd or app root).
  ann_persist_path: "data_labeling/annotations.jsonl"

  # If true, register atexit handler to flush annotations on process exit.
  ann_flush_on_exit: true

  # If true, register SIGINT/SIGTERM handlers that flush then exit.
  ann_install_signal_handlers: true

  # Human labeling path (full-paper tasks): pending papers for HumanLabellerSDK.
  human_paper_queue: "q:papers:human:v1"

  # In-flight human-queue items (same claim/ack pattern as paper_processing).
  human_processing_queue: "q:papers:human:processing:v1"

  # Dedup SET for human pipeline (seed_human_queue uses enqueue_paper_id_human).
  human_dedup_set: "s:papers:human:enqueued:v1"

# -----------------------------------------------------------------------------
# minio — S3-compatible object storage
# -----------------------------------------------------------------------------
# Used for raw PDFs/text, LLM classification JSON (`bucket_name`), and exported
# annotations (`annotations_bucket`, `human_annotations_bucket`).
#
minio:
  # Host:port (no scheme). TLS: set secure: true and use the correct port.
  url: "localhost:9000"

  # S3 access key (MINIO_ROOT_USER or created user).
  access_key: ""

  # S3 secret key.
  secret_key: ""

  # Bucket where the labeler writes classified results: objects are `{model_id}/{paper_id}.json`.
  # Label Studio importer and save_results use this bucket.
  synthetic_data_bucket: "synthetic-data"

  # Source articles (PubMed BioC JSON downloads). Used by bioc_downloader.py (write),
  # data_generation + label_api (read via papers/), and seed_queue_from_bucket (read).
  # This is the single source of truth for the raw-articles bucket name.
  raw_articles_bucket: "raw-pubmed-articles"

  # Use HTTPS and verify TLS when true (typical on cloud; local MinIO often false).
  secure: false

  # Webhook handler writes completed human-LS annotations under this bucket.
  human_annotations_bucket: "human-annotations"

  # Webhook handler writes completed model-review annotations under this bucket.
  annotations_bucket: "completed-annotations"

# -----------------------------------------------------------------------------
# label_studio — annotation UI + API
# -----------------------------------------------------------------------------
# FastAPI app uses URL + api_key for LabelStudio SDK; webhook_host is where LS
# POSTs ANNOTATION_* events (must match a route your API exposes, typically /webhook).
#
label_studio:
  # Base URL of Label Studio, e.g. http://localhost:8080 (no trailing slash required).
  url: ""

  # Personal access token or project token from LS (Settings → Account / Token).
  api_key: ""

  # Full base URL of *this repo’s* FastAPI server as reachable FROM Label Studio,
  # e.g. http://localhost:8000 — used when registering webhooks (path /webhook appended).
  webhook_host: "http://localhost:8000"

# -----------------------------------------------------------------------------
# papers — whole-paper loading for model labeling and human review
# -----------------------------------------------------------------------------
# Papers are read from minio.raw_articles_bucket as {raw_prefix}/{pmid}.json (raw
# BioC written by data_download), rendered in full, and shown to models / reviewers.
#
papers:
  # MinIO prefix holding the raw articles. Omit (or null) to use
  # bioc_download.object_prefix, so download and labeling always agree.
  # raw_prefix: "test_041826_v3"

  # BioC section types dropped before anyone sees the paper.
  exclude_section_types: ["REF", "AUTH_CONT", "COMP_INT", "ACK_FUND"]

  # Optional cap on rendered paper length in characters (null = whole paper).
  # Set this only for models whose context window cannot fit a full article.
  max_chars: null

# -----------------------------------------------------------------------------
# seed — default input files for queue seeding scripts
# -----------------------------------------------------------------------------
seed:
  # One paper ID per line; consumed by `python -m utilities.seed_queue` → main labeling queue.
  queue_file: "utilities/test_papers.txt"

  # One paper ID per line; consumed by `python -m utilities.seed_human_queue`.
  human_papers_file: "utilities/human_papers.txt"

# -----------------------------------------------------------------------------
# llm_providers — chat/completion backends for criterion labeling
# -----------------------------------------------------------------------------
# Top-level keys are provider *types* (openai, anthropic, ollama, huggingface, vllm).
# Each provider has:
#   - api_key: optional at provider level; merged into each model unless model overrides.
#   - models: list of per-model entries (see below).
#
# Each model entry includes:
#   - model: string ID (also MinIO prefix for saved JSON: `{model}/{paper_id}.json`).
#   - temperature: sampling temperature for provider.
#   - skip: if true, this model is not instantiated (exclude from get_providers_dict).
#   - max_tokens, top_p, frequency_penalty, presence_penalty: optional; passed to provider.
#   - base_url: OpenAI-compatible or Ollama/vLLM base URL where applicable.
#   - timeout: optional HTTP timeout seconds.
#   - api_key: optional per-model override (rare).
#   - options (ollama): passed through as Ollama request options, e.g. num_ctx.
#     Set num_ctx for whole-paper labeling: without it the server's default context
#     applies and Ollama silently drops the start of longer prompts.
#   - think (ollama): enable the model's reasoning mode (default false). Raise
#     max_tokens if you turn it on; reasoning tokens count against it.
# Extra YAML keys are allowed (extra="allow") for future options.
#
# Docs: Anthropic model IDs — https://docs.anthropic.com/en/docs/about-claude/models/overview
#
llm_providers:
  ollama:
    api_key: dummy
    models:
      # Shared UNLV CS Ollama servers (falcon9, oceanus) on port 11434.
      - model: qwen3.8:27b
        base_url: http://falcon9.cs.unlv.edu:11434
        temperature: 0.1
        timeout: 1800
        options: {num_ctx: 262144}
        skip: false

  openai:
    api_key: ""
    models:
      - model: gpt-4o
        temperature: 0.1
        skip: true

  anthropic:
    api_key: ""
    models:
      - model: claude-sonnet-4-6
        temperature: 0.1
        skip: true

  huggingface:
    api_key: ""
    models:
      - model: microsoft/DialoGPT-medium
        temperature: 0.1
        skip: true

  vllm:
    # Optional placeholder; code uses "EMPTY" if unset for OpenAI-compatible local servers.
    api_key: "EMPTY"
    models:
      - model: "openai/gpt-oss-120b"
        base_url: "http://localhost:8080/v1"
        temperature: 0.1
        skip: false

  vllm_native:
    models:
      - model: "meta-llama/Llama-3.1-8B-Instruct"
        temperature: 0.1
        tensor_parallel_size: 1
        dtype: "bfloat16"
        gpu_memory_utilization: 0.90
        skip: true

# -----------------------------------------------------------------------------
# bioc_download — PubMed BioC downloader (data_download/)
# -----------------------------------------------------------------------------
# Used by: data_download/bioc_downloader.py via load_app_config().
# MinIO connection (url, access_key, secret_key, secure) comes from the minio: block above.
# Only BioC-specific settings live here.
#
bioc_download:
  # The target MinIO bucket comes from minio.raw_articles_bucket above.
  # Only the per-run prefix lives here so the downloader, ingester, and
  # queue seeder always agree on the bucket name.
  #
  # Optional key prefix (folder path) within the bucket.
  # e.g. "run_2026_04" → objects land at run_2026_04/{pmid}.json.
  # Leave empty to write directly into the bucket root.
  object_prefix: ""
  # NCBI E-utilities API key — raises rate limit from 3 req/s to 10 req/s.
  # Register free at: https://www.ncbi.nlm.nih.gov/account/
  ncbi_api_key: ""

  # Email address for NCBI usage policy (recommended, not required).
  ncbi_email: ""

  # MeSH query — three ways to specify, evaluated highest to lowest priority:
  #
  #   1. mesh_query  — raw PubMed query string, passed verbatim to esearch.
  #                    Use for full boolean control (OR groups, NOT, etc.).
  mesh_query: ""

  #   2. mesh_terms  — list of qualified MeSH terms; auto-joined with AND
  #                    and wrapped with [MAJR] when major_topic_only is true.
  mesh_terms: []
  # mesh_terms:
  #   - "alzheimer disease/blood"
  #   - "biomarkers/blood"

  #   3. mesh_ids    — list of MeSH descriptor UIDs.
  mesh_ids: []
  # mesh_ids:
  #   - "D000544"
  #   - "D015415"

  # When true, auto-built queries use [MAJR] so only papers where the MeSH term
  # is a *major* focus are returned (not just mentioned in passing).
  major_topic_only: true

  # Maximum number of PMIDs to retrieve from the esearch result set.
  max_results: 100

  # Number of articles fetched per BioC API request batch.
  batch_size: 25

  # Seconds to wait between BioC API requests (respects NCBI rate limits).
  request_delay: 0.34

  # When true, fetch full article text via the PMC Open Access endpoint
  # (pmcoa.cgi) instead of the PubMed abstract endpoint (pubmed.cgi).
  # Only articles in the PMC OA subset have full text available — paywalled
  # articles will return 404 from pmcoa.cgi.
  full_text: false

  # When full_text is true and an article is not in PMC OA (404), fall back
  # to the PubMed abstract instead of skipping the article entirely.
  full_text_fallback: true