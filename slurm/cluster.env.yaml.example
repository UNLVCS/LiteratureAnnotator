# .env.yaml for the GPU cluster checkout: cp slurm/cluster.env.yaml.example .env.yaml
#
# No secrets here. MinIO keys come from Vault through the job's SSH tunnel, and the job
# points minio.url and the model server at its own tunnel/server ports via
# $LA_CONFIG_OVERRIDE (see slurm/label_vllm.sbatch).

minio:
  url: "localhost:9000"          # replaced per job with the tunnel port
  secure: false                  # plain HTTP inside the SSH tunnel (the tunnel encrypts)
  raw_articles_bucket: "raw-pubmed-articles"
  synthetic_data_bucket: "synthetic-data"
  # Results land at synthetic-data/{output_prefix}/{model}/{pmid}.json
  output_prefix: "pilot_2026_10"

papers:
  raw_prefix: "pilot_2026_10"    # MinIO folder holding the papers to label

# The model is served by `vllm serve` inside the job; the job fills in base_url.
llm_providers:
  vllm:
    api_key: "EMPTY"
    models:
      - model: "openai/gpt-oss-120b"
        temperature: 0.1
        # gpt-oss reasons before answering; the reasoning counts toward max_tokens.
        max_tokens: 8000
        skip: false
