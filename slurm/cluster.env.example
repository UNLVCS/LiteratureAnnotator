# Machine-specific settings for slurm/label_vllm.sbatch: cp slurm/cluster.env.example slurm/cluster.env
# (gitignored). Sourced by the job; every path is on the cluster.

# SSH tunnel to the server hosting MinIO and Vault.
LA_TUNNEL_HOST="abreham@vostok.cs.unlv.edu"
LA_SSH_KEY="$HOME/.ssh/vostok_tunnel"          # dedicated key, see slurm/README.md

# Vault AppRole (read-only app role) and its CA certificate (copied from vostok).
VAULT_ROLE_ID=""
VAULT_SECRET_ID_FILE="$HOME/.la/vault-secret-id"   # chmod 600
LA_VAULT_CACERT="$HOME/.la/vault-cert.pem"

# Hugging Face cache for model weights (gpt-oss-120b is ~65 GB). Must persist across jobs:
# on UNLV HPC /scratch is per-job (/scratch/$SLURM_JOB_ID), so use the shared home volume.
HF_HOME="$HOME/hf"
