# Docker overrides. Copy to .env.docker-override.yaml and add your API keys.
# Merges over base .env.yaml. Add only values that differ in Docker.

redis:
  url: "redis://redis:6379/0"

minio:
  url: "minio:9000"
  access_key: ""  # e.g. minioadmin
  secret_key: ""  # e.g. minioadmin

label_studio:
  url: "http://label-studio:8080"
  webhook_host: "http://host.docker.internal:8000"
  api_key: ""     # Required: get from Label Studio → Account & Settings → Access Token
