# =============================================================================
# Docker-only configuration overrides (example)
# =============================================================================
# Copy to `.env.docker-override.yaml` (or merge manually into `override.env.yaml`).
#
# In `label_api/docker-compose.yml`, this file is typically mounted as:
#   ../.env.docker-override.yaml → /app/override.env.yaml
# so `load_app_config()` deep-merges these values ON TOP of your base `.env.yaml`.
#
# Include ONLY keys that must differ inside Docker (hostnames, webhook URL, secrets
# you inject only in containers). Everything else stays in `.env.yaml`.
# =============================================================================

redis:
  # Inside Docker Compose, Redis service DNS name is usually `redis`, not localhost.
  # Port 6379 is the default Redis container port; path `/0` is database index 0.
  url: "redis://:CHANGE_ME_MATCH_REDIS_PASSWORD_IN_label_api/.env@redis:6379/0"

minio:
  # MinIO service hostname on the Docker network. Port 9000 is the S3 API port.
  # Must match `url` in base `.env.yaml` except host (still no http(s) prefix).
  url: "minio:9000"

label_studio:
  # Label Studio container’s HTTP port (see docker-compose `label-studio` service).
  # The FastAPI backend uses this to call the LS API from inside the Compose network.
  url: "http://label-studio:8080"

  # URL of the FastAPI app AS SEEN FROM Label Studio / the browser callback path.
  # `host.docker.internal` reaches the host machine from some Docker setups so LS can
  # POST webhooks to uvicorn on the host (e.g. port 8000). Adjust if the API runs
  # inside Compose (then use the backend service name and port instead).
  webhook_host: "http://host.docker.internal:8000"
